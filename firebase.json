{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      ".git",
      ".git/**",
      "**/.git/**",
      ".env",
      "**/.env*",
      ".gitignore",
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.md",
      "package*.json",
      "*.log",
      "functions/**",
      "scratch/**",
      "scripts/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/chat",
        "function": "groqChat"
      },
      {
        "source": "/api/submitDispatch",
        "function": "submitDispatch"
      },
      { "source": "/dashboard", "destination": "/pages/dashboard.html" },
      { "source": "/dashboard.html", "destination": "/pages/dashboard.html" },
      { "source": "/terminal", "destination": "/pages/terminal.html" },
      { "source": "/terminal.html", "destination": "/pages/terminal.html" },
      { "source": "/ctf", "destination": "/pages/ctf.html" },
      { "source": "/ctf.html", "destination": "/pages/ctf.html" },
      { "source": "/payloads", "destination": "/pages/payloads.html" },
      { "source": "/payloads.html", "destination": "/pages/payloads.html" },
      { "source": "/games", "destination": "/pages/games.html" },
      { "source": "/games.html", "destination": "/pages/games.html" },
      { "source": "/notes", "destination": "/pages/notes.html" },
      { "source": "/notes.html", "destination": "/pages/notes.html" },
      { "source": "/ai_assistant", "destination": "/pages/ai_assistant.html" },
      { "source": "/ai_assistant.html", "destination": "/pages/ai_assistant.html" },
      { "source": "/contact", "destination": "/pages/contact.html" },
      { "source": "/contact.html", "destination": "/pages/contact.html" },
      { "source": "/privacy", "destination": "/pages/privacy.html" },
      { "source": "/privacy.html", "destination": "/pages/privacy.html" },
      { "source": "/thank-you", "destination": "/pages/thank-you.html" },
      { "source": "/thank-you.html", "destination": "/pages/thank-you.html" }
    ],
    "redirects": [
      { "source": "/.git", "destination": "/404", "type": 301 },
      { "source": "/.git/**", "destination": "/404", "type": 301 },
      { "source": "/index.html", "destination": "/", "type": 301 },
      { "source": "/roadmap", "destination": "/masterguide/roadmap", "type": 301 },
      { "source": "/roadmap.html", "destination": "/masterguide/roadmap", "type": 301 },
      { "source": "/modules/Vulnerablity", "destination": "/modules/Vulnerability", "type": 301 },
      { "source": "/modules/Vulnerablity.html", "destination": "/modules/Vulnerability", "type": 301 },
      { "source": "/modules/VulnerabilityAnalysis", "destination": "/modules/Vulnerability", "type": 301 },
      { "source": "/modules/VulnerabilityAnalysis.html", "destination": "/modules/Vulnerability", "type": 301 },
      { "source": "/imp_info", "destination": "/imp_info/imp_info", "type": 301 },
      { "source": "/career_paths", "destination": "/imp_info/career_paths", "type": 301 },
      { "source": "/ports", "destination": "/imp_info/ports", "type": 301 },
      { "source": "/http_codes", "destination": "/imp_info/http_codes", "type": 301 },
      { "source": "/general", "destination": "/imp_info/general", "type": 301 },
      { "source": "/masterguide/imp_info", "destination": "/imp_info/imp_info", "type": 301 },
      { "source": "/masterguide/career_paths", "destination": "/imp_info/career_paths", "type": 301 },
      { "source": "/masterguide/ports", "destination": "/imp_info/ports", "type": 301 },
      { "source": "/masterguide/http_codes", "destination": "/imp_info/http_codes", "type": 301 },
      { "source": "/masterguide/general", "destination": "/imp_info/general", "type": 301 },
      { "source": "/masterguide/masterguide_ch1", "destination": "/masterguide/cybersecurity_masterguide?ch=1", "type": 301 },
      { "source": "/masterguide/masterguide_ch2", "destination": "/masterguide/cybersecurity_masterguide?ch=2", "type": 301 },
      { "source": "/masterguide/masterguide_ch3", "destination": "/masterguide/cybersecurity_masterguide?ch=3", "type": 301 },
      { "source": "/masterguide/masterguide_ch4", "destination": "/masterguide/cybersecurity_masterguide?ch=4", "type": 301 },
      { "source": "/masterguide/masterguide_ch5", "destination": "/masterguide/cybersecurity_masterguide?ch=5", "type": 301 },
      { "source": "/masterguide/masterguide_ch6", "destination": "/masterguide/cybersecurity_masterguide?ch=6", "type": 301 },
      { "source": "/masterguide/masterguide_ch7", "destination": "/masterguide/cybersecurity_masterguide?ch=7", "type": 301 },
      { "source": "/masterguide/masterguide_ch8", "destination": "/masterguide/cybersecurity_masterguide?ch=8", "type": 301 },
      { "source": "/masterguide/masterguide_ch9", "destination": "/masterguide/cybersecurity_masterguide?ch=9", "type": 301 },
      { "source": "/masterguide/masterguide_ch10", "destination": "/masterguide/cybersecurity_masterguide?ch=10", "type": 301 }
    ],
    "headers": [
      {
        "source": "sitemap.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "sitemap.xml",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "@(js/config.js|sw.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "@(*.html|**/*.html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://fonts.googleapis.com https://cdnjs.cloudflare.com https://www.gstatic.com https://*.firebaseio.com https://apis.google.com https://accounts.google.com https://*.firebaseapp.com https://*.googleapis.com https://*.google.com https://www.google.com https://recaptcha.net https://*.recaptcha.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; media-src 'self' data: https:; connect-src 'self' https://api.groq.com https://*.googleapis.com https://*.google.com https://*.firebaseio.com https://firestore.googleapis.com https://accounts.google.com https://*.firebaseapp.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://*.google.com https://www.google.com https://recaptcha.net https://*.recaptcha.net; object-src 'none'; base-uri 'self';"
          }
        ]
      }
    ]
  }
}
