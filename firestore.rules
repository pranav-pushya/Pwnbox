rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each operative has their own private vault for notes and progress
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Operative contact transmissions / bug reports (write-only for clients, read disabled)
    match /operative_dispatches/{dispatchId} {
      allow create: if request.resource.data.keys().hasAll(['callsign', 'email', 'message', 'submittedAt'])
                    && request.resource.data.callsign is string && request.resource.data.callsign.size() <= 80
                    && request.resource.data.email is string && request.resource.data.email.size() <= 120
                    && request.resource.data.message is string && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if false; // Only accessible by administrators / backend
    }
  }
}
